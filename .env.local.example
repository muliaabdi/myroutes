# LocationIQ API Key
# Get your free API key at: https://locationiq.com/
# Sign up for free account (5,000 requests/day)
LOCATIONIQ_API_KEY=your_locationiq_api_key_here

# Optional: Mapbox Token for Traffic Overlay
# Get your token at: https://www.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# Optional: Upstash Redis (for Vercel serverless live status caching)
# Get from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

